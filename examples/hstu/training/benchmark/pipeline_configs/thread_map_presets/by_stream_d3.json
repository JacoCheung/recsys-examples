{
  "version": 1,
  "thread_map": {
    "h2d": "memcpy",
    "start_shuffle": "memcpy",
    "finish_shuffle": "memcpy",
    "start_input_dist": "data_dist",
    "wait_input_dist": "data_dist",
    "prefetch_embeddings": "prefetch",
    "zero_grad": "default",
    "global_tokens_allreduce": "default",
    "compute_output_dist": "default",
    "ranking_embedding_forward": "default",
    "dense_forward": "default",
    "dense_backward": "default",
    "embedding_backward": "default",
    "finalize_model_grads": "default",
    "optimizer_step": "default",
    "watchdog_step": "default"
  },
  "lookahead": {
    "h2d": 2,
    "start_shuffle": 2,
    "finish_shuffle": 2,
    "start_input_dist": 1,
    "wait_input_dist": 1,
    "prefetch_embeddings": 1,
    "zero_grad": 0,
    "global_tokens_allreduce": 0,
    "compute_output_dist": 0,
    "ranking_embedding_forward": 0,
    "dense_forward": 0,
    "dense_backward": 0,
    "embedding_backward": 0,
    "finalize_model_grads": 0,
    "optimizer_step": 0,
    "watchdog_step": 0
  },
  "same_progress_sync": {
    "h2d": [{"task": "compute_output_dist", "sides": "both"}],
    "start_shuffle": [{"task": "compute_output_dist", "sides": "both"}],
    "finish_shuffle": [{"task": "compute_output_dist", "sides": "both"}],
    "start_input_dist": [{"task": "compute_output_dist", "sides": "both"}],
    "wait_input_dist": [{"task": "compute_output_dist", "sides": "both"}],
    "prefetch_embeddings": [{"task": "compute_output_dist", "sides": "both"}],
    "embedding_backward": [{"task": "prefetch_embeddings", "sides": "both"}]
  }
}
